# Copy to .env and fill in. Never commit .env.

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SUPERVISOR_MODEL=claude-opus-5-5
SPECIALIST_MODEL=claude-sonnet-5-5
REVIEWER_MODEL=claude-sonnet-5-5

# Infrastructure (defaults match docker-compose.yml)
DATABASE_URL=postgresql+psycopg://agentorch:agentorch@localhost:5432/agentorch
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Human-in-the-loop
# Optional: Slack incoming-webhook URL for 'review needed' messages
REVIEW_WEBHOOK_URL=
PLAN_CONFIDENCE_THRESHOLD=0.7
REVIEW_QUALITY_THRESHOLD=0.7
MAX_SPECIALIST_RETRIES=2

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentorch
